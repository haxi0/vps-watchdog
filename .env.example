# ============================================================================
# Режим с несколькими ВМ (рекомендуется, если ВМ больше одной или они находятся
# в разных организациях / облаках Яндекс Облака).
# Укажите путь к JSON-конфигу внутри контейнера. См. config.example.json.
# Если переменная задана, она имеет приоритет над VM_HOST / INSTANCE_ID ниже.
# ============================================================================
# WATCHDOG_CONFIG=/app/config.json

# ============================================================================
# Режим с одной ВМ (для обратной совместимости).
# Используется только если WATCHDOG_CONFIG не задан.
# ============================================================================

# IP адрес или DNS имя вашего VPS, который будет пинговаться
VM_HOST=1.2.3.4

# ID виртуальной машины в Яндекс Облаке, которую нужно запускать
INSTANCE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Путь к ключу сервисного аккаунта (относительно контейнера)
SA_KEY_PATH=/app/sa-key.json

# ============================================================================
# Общие параметры (используются как значения по умолчанию для всех целей).
# ============================================================================

# Интервал между проверками доступности (в секундах)
CHECK_INTERVAL=30

# Количество попыток пинга перед признанием сервера недоступным
PING_ATTEMPTS=3

# Таймаут ожидания ответа ping (в секундах)
PING_TIMEOUT=1